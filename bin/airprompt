#!/bin/bash
# airprompt — Unified dispatch for multi-word arguments.
# /airprompt on "my project" → bash airprompt-on.sh --name "my project"
# /airprompt on --name foo    → bash airprompt-on.sh --name foo
# /airprompt on               → bash airprompt-on.sh
# /airprompt name something   → bash airprompt-name.sh "something"
set -euo pipefail

# Resolve real script dir (follow symlink from ~/bin/ → repo/bin/) without
# `readlink -f`/`realpath` (absent on macOS ≤12). `cd … && pwd -P` is portable.
_self="${BASH_SOURCE[0]:-$0}"
_n=0
while [ -L "$_self" ] && [ "$_n" -lt 20 ]; do
  _n=$((_n + 1))
  _link="$(readlink "$_self" 2>/dev/null)" || break
  case "$_link" in
    /*) _self="$_link" ;;
    *)  _self="$(cd "$(dirname "$_self")" 2>/dev/null && pwd -P)/$_link" || break ;;
  esac
done
SELF_DIR="$(cd "$(dirname "$_self")" 2>/dev/null && pwd -P)" || SELF_DIR="$(dirname "$_self")"

# Restore ~/bin/ symlinks + wrappers if clean nuked them (before dispatching)
# shellcheck source=/dev/null
source "${SELF_DIR}/lib/protocol.sh"
_ensure_bin_symlinks

CMD="${1:-}"
shift || true
# Remaining positional args in "$@" after shift

# ── tmux warning (not inside tmux → phone shows mirror shell, not live UI) ─
_warn_if_not_tmux "$CMD"

# ── Provider auto-detection (only for commands that need it) ────────────
# Runs before dispatching to sub-scripts that require AIRPROMPT_PROVIDER.
_ensure_provider() {
  if [ -n "${AIRPROMPT_PROVIDER:-}" ]; then return 0; fi
  local detected
  detected="$(node "$SELF_DIR/lib/resolve-provider.js" || true)"
  if [ -n "$detected" ]; then
    export AIRPROMPT_PROVIDER="$detected"
    return 0
  fi
  echo "AirPrompt: no provider detected and AIRPROMPT_PROVIDER not set." >&2
  echo "  Install claude, codex, cursor, or windsurf" >&2
  echo "  Or set AIRPROMPT_PROVIDER manually." >&2
  return 1
}

# Default: no args → run status + help
if [ -z "$CMD" ]; then
  # Resolve install dir for sub-scripts
  for d in "${AIRPROMPT_INSTALL_DIR:-}" ~/.airprompt ~/projects/airprompt; do
    [ -d "$d" ] || continue
    STATUS_SH="$d/bin/airprompt-status.sh"
    if [ -x "$STATUS_SH" ]; then
      bash "$STATUS_SH" || true # status may exit non-zero (stale pidfile) — still print help
      echo ""
      echo ""
    fi
    break
  done
  # Print help
  echo "AirPrompt — remote mobile access and voice dictation for IDE sessions"
  echo ""
  echo "ALL COMMANDS EXECUTE IMMEDIATELY — NO CONFIRMATION EVER."
  echo ""
  echo "Usage: /airprompt <command>"
  echo ""
  echo "Commands:"
  echo "  on [<name>]         Start daemon + register session (optional name)"
  echo "  on --name <name>    Same, explicit flag form"
  echo "  off                 Unregister session + hide statusline badge"
  echo "  auth list|allow|deny|revoke|name  Manage paired devices (device pairing)"
  echo "  status              Show daemon status and active sessions"
  echo "  clean               Full teardown — kill all sessions, remove markers"
  echo "  restart             Restart daemon — sessions survive via disk recovery"
  echo "  name [<text>]       Set or clear session name (empty or \"\" clears)"
  echo "  autostart on|off    Auto-start AirPrompt on IDE session start"
  echo "  update [<tag>]      Update install to a release tag (or latest main)"
  echo "  help                Show this help"
  echo ""
  echo "Entrypoint: always use 'airprompt <command>' — never call bin/airprompt-*.sh directly."
  exit 0
fi

# Resolve install dir
for d in "${AIRPROMPT_INSTALL_DIR:-}" ~/.airprompt ~/projects/airprompt; do
  [ -d "$d" ] || continue
  SUB=""
  case "$CMD" in
    on)        SUB="$d/bin/airprompt-on.sh";;
    off)       SUB="$d/bin/airprompt-off.sh";;
    auth)      SUB="$d/bin/airprompt-auth.sh";;
    status)    SUB="$d/bin/airprompt-status.sh";;
    clean)     SUB="$d/bin/airprompt-clean.sh";;
    restart)   SUB="$d/bin/airprompt-restart.sh";;
    name)      SUB="$d/bin/airprompt-name.sh";;
    autostart) SUB="$d/bin/airprompt-autostart.sh";;
    update)    SUB="$d/bin/airprompt-update.sh";;
    help|-h|--help)
      echo "AirPrompt — remote mobile access and voice dictation for IDE sessions"
      echo ""
      echo "ALL COMMANDS EXECUTE IMMEDIATELY — NO CONFIRMATION EVER."
      echo ""
      echo "Usage: /airprompt <command>"
      echo ""
      echo "Commands:"
      echo "  on [<name>]         Start daemon + register session (optional name)"
      echo "  on --name <name>    Same, explicit flag form"
      echo "  off                 Unregister session + hide statusline badge"
      echo "  auth list|allow|deny|revoke|name  Manage paired devices (device pairing)"
      echo "  status              Show daemon status and active sessions"
      echo "  clean               Full teardown — kill all sessions, remove markers"
      echo "  restart             Restart daemon — sessions survive via disk recovery"
      echo "  name [<text>]       Set or clear session name (empty or \"\" clears)"
      echo "  autostart on|off    Auto-start AirPrompt on IDE session start"
      echo "  help                Show this help"
      echo ""
      echo "Entrypoint: always use 'airprompt <command>' — never call bin/airprompt-*.sh directly."
      exit 0
      ;;
    *)      echo "AirPrompt: unknown command '$CMD'. Try: on, off, status, clean, restart, name, autostart, auth, update, help" >&2; exit 1 ;;
  esac
  if [ -x "$SUB" ]; then
    # --help delegation never needs a provider — run it first
    if [ $# -gt 0 ] && { [ "$1" = "--help" ] || [ "$1" = "-h" ]; }; then
      exec bash "$SUB" --help
    fi
    # Commands that need a provider (autostart resolves its own, and supports
    # AIRPROMPT_SETTINGS_FILE; off finds its session provider-agnostically)
    case "$CMD" in on|name) _ensure_provider || exit 1 ;; esac
    case "$CMD" in
      on)
        if [ $# -gt 0 ] && [ "$1" = "--name" ]; then
          exec bash "$SUB" "$@"      # user passed --name explicitly
        elif [ $# -gt 0 ]; then
          exec bash "$SUB" --name "$1"  # convenience: first positional → name
        else
          exec bash "$SUB"
        fi
        ;;
      name)
        exec bash "$SUB" "$@"
        ;;
      autostart)
        exec bash "$SUB" "$@"
        ;;
      auth)
        exec bash "$SUB" "$@"
        ;;
      update)
        exec bash "$SUB" "$@"
        ;;
      *)
        exec bash "$SUB"
        ;;
    esac
  fi
done

echo "Error: airprompt scripts not found" >&2
exit 1

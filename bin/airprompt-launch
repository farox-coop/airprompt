#!/bin/bash
# airprompt-launch — Start an IDE/CLI inside tmux so AirPrompt can
# mirror it on your phone. Version-controlled in the AirPrompt repo.
#
# Provider-agnostic: use --provider to select the IDE, --binary to override
# the IDE binary path.
#
# Usage:  airprompt-launch [--provider <id>] [--binary <path>] [ide-args...]
#         airprompt-launch --continue [<session_id>]
#         airprompt-launch --resume <session_id>
#         airprompt-launch --name <name> [ide-args...]
#
# --provider <id>   IDE provider (required). Uses provider's binary.
# --binary <path>   Override the IDE binary path.
# --name <name>     Name this session — the AirPrompt marker always, the tmux
#                   session on a fresh launch — and, when the provider
#                   declares a name flag of its own (src/providers/*.js,
#                   `sessionNameFlag`), forward the same name to the IDE too.
#                   Do not also pass the IDE's own flag: the name would be
#                   set twice.
#                   AIRPROMPT_IDE_NAME_FLAG overrides the provider's flag
#                   (empty disables the forwarding).

set -euo pipefail

# ── Provider resolution ─────────────────────────────────────────────────
PROVIDER_ID=""
REAL_BINARY=""
PROVIDER_EXPLICIT=false

while [ $# -gt 0 ]; do
  case "$1" in
    --provider)
      if [ $# -lt 2 ]; then
        echo "Error: --provider requires an argument" >&2
        exit 1
      fi
      PROVIDER_ID="$2"
      PROVIDER_EXPLICIT=true
      shift 2
      ;;
    --binary)
      if [ $# -lt 2 ]; then
        echo "Error: --binary requires a path" >&2
        exit 1
      fi
      REAL_BINARY="$2"
      shift 2
      ;;
    *)
      break
      ;;
  esac
done

# Validate provider ID
if [ -z "$PROVIDER_ID" ]; then
  PROVIDER_ID="${AIRPROMPT_PROVIDER:-}"
fi
if [ -z "$PROVIDER_ID" ]; then
  echo "Error: --provider is required (or set AIRPROMPT_PROVIDER)" >&2
  exit 1
fi
if [ ${#PROVIDER_ID} -gt 32 ] || ! echo "$PROVIDER_ID" | grep -qE '^[a-z][a-z0-9-]*$'; then
  echo "Error: invalid provider ID: $PROVIDER_ID (must be ≤32 chars, match ^[a-z][a-z0-9-]*$)" >&2
  exit 1
fi

# Resolve binary from provider if not explicitly given
if [ -z "$REAL_BINARY" ]; then
  # Check PATH first, then common install locations
  if command -v "$PROVIDER_ID" >/dev/null 2>&1; then
    REAL_BINARY="$(command -v "$PROVIDER_ID")"
  elif [ -x "$HOME/.local/bin/$PROVIDER_ID" ]; then
    REAL_BINARY="$HOME/.local/bin/$PROVIDER_ID"
  elif [ -x "/usr/local/bin/$PROVIDER_ID" ]; then
    REAL_BINARY="/usr/local/bin/$PROVIDER_ID"
  else
    echo "Error: IDE binary '$PROVIDER_ID' not found" >&2
    echo "  Checked: PATH, ~/.local/bin/$PROVIDER_ID, /usr/local/bin/$PROVIDER_ID" >&2
    echo "  Use --binary <path> to specify the IDE path" >&2
    exit 1
  fi
fi

if [ ! -x "$REAL_BINARY" ]; then
  echo "Error: IDE binary '$REAL_BINARY' is not executable" >&2
  exit 1
fi

# ── Self location + install root ────────────────────────────────────────
# Resolve this script's real location by following symlinks, without
# `readlink -f`/`realpath` (absent on macOS ≤12).
_resolve_self() {
  local self _n _link
  self="${BASH_SOURCE[0]:-$0}"
  _n=0
  while [ -L "$self" ] && [ "$_n" -lt 20 ]; do
    _n=$((_n + 1))
    _link="$(readlink "$self" 2>/dev/null)" || break
    case "$_link" in
      /*) self="$_link" ;;
      *)  self="$(cd "$(dirname "$self")" 2>/dev/null && pwd -P)/$_link" || break ;;
    esac
  done
  self="$(cd "$(dirname "$self")" 2>/dev/null && pwd -P)/$(basename "$self")" || self="${BASH_SOURCE[0]:-$0}"
  printf '%s' "$self"
}

# Install root — the directory holding bin/ and src/ (a dev checkout or
# ~/.airprompt). Fails (non-zero) when the layout is not there, so a caller
# can fall back instead of reading a bogus path.
_resolve_root() {
  local self parent
  self="$(_resolve_self)"
  parent="$(cd "$(dirname "$self")/.." 2>/dev/null && pwd -P)" || return 1
  [ -d "$parent/src/providers" ] || return 1
  printf '%s' "$parent"
}

# ── The IDE's own session-name flag ─────────────────────────────────────
# `--name` is AirPrompt's flag: it names the marker dir and the tmux session.
# Where the IDE has a name flag of its own, the same name is forwarded to it
# too, so one flag names both sides and the CLI's own surfaces that show that
# name — the prompt box, the `/resume` picker and the terminal title — agree
# with the tmux session.
#
# The flag is provider knowledge, so it lives in the provider adapters
# (src/providers/*.js, field `sessionNameFlag`) — this script stays
# provider-agnostic on purpose (see bin/airprompt-agnostic-check.sh). The
# lookup is best-effort: no node, no install root, unknown provider or a null
# field all mean "no flag", never a failed launch.
#
# AIRPROMPT_IDE_NAME_FLAG overrides the lookup; set it empty to disable the
# forwarding entirely.
_ide_name_flag() {
  if [ -n "${AIRPROMPT_IDE_NAME_FLAG+set}" ]; then
    printf '%s' "$AIRPROMPT_IDE_NAME_FLAG"
    return 0
  fi
  command -v node >/dev/null 2>&1 || return 0
  local root flag
  root="$(_resolve_root)" || return 0
  flag="$(node -e 'try {
      const registry = require(process.argv[1] + "/src/providers/registry");
      const provider = registry.loadProvider(process.argv[2]);
      const f = provider.sessionNameFlag;
      process.stdout.write(typeof f === "string" ? f : "");
    } catch (_) {}' "$root" "$PROVIDER_ID" 2>/dev/null)" || flag=""
  printf '%s' "$flag"
}

# ── Self-install: ensure ~/bin/ has airprompt-launch + provider wrapper ─
_ensure_launcher() {
  if [ "${AIRPROMPT_NO_SELF_INSTALL:-}" = "1" ]; then return 0; fi
  if ! $PROVIDER_EXPLICIT; then return 0; fi  # only --provider flag, not env fallback

  local home_bin="${HOME}/bin"
  mkdir -p "$home_bin" 2>/dev/null || true

  local self
  self="$(_resolve_self)"

  # Symlink: ~/bin/airprompt-launch → this script
  local launch_link="${home_bin}/airprompt-launch"
  if [ ! -L "$launch_link" ] && [ ! -f "$launch_link" ]; then
    ln -s "$self" "$launch_link" 2>/dev/null || true
  fi

  # Wrapper: ~/bin/airprompt-{provider}
  local wrapper="${home_bin}/airprompt-${PROVIDER_ID}"
  if [ ! -x "$wrapper" ] && [ ! -f "$wrapper" ]; then
    cat > "$wrapper" << WRAPPEREOF
#!/bin/bash
exec airprompt-launch --provider ${PROVIDER_ID} "\$@"
WRAPPEREOF
    chmod +x "$wrapper"
  fi
}
_ensure_launcher

SESSIONS_DIR="${AIRPROMPT_SESSIONS_DIR:-$HOME/.airprompt/sessions}"

# ── Collect env vars to forward to IDE inside tmux ───────────────────
# Tmux does NOT forward all env vars to new sessions by default — only the
# ones listed in update-environment (DISPLAY, SSH_*, etc.). Inline env vars
# like CLAUDE_CODE_EFFORT_LEVEL=high airprompt-launch would never reach the
# real IDE process. We collect everything except AirPrompt-internal vars
# (AIRPROMPT_*) and pass them explicitly via `env -i` in every tmux command.
#
# `-i` is load-bearing, not tidiness. A tmux session's environment STARTS as a
# copy of the server's, and the server's is the environment of whichever client
# happened to start it — so any var in that server and not in this launch (a
# per-project git scope, a port, a Docker project name, a token that belongs to
# one session) reaches the IDE anyway, silently, and outlives whatever set it.
# Those stale values are worse than missing ones: nothing on screen says where
# they came from. With `-i` the IDE inherits this caller's environment and
# nothing from that server, which is what "forward the environment" has to mean.
#
# The three vars tmux owns for a pane — TMUX, TMUX_PANE and TERM — are the ones
# this cannot simply drop. tmux injects them into the process it starts, and
# `env -i` would clear the only copy, leaving the IDE reporting "not inside
# tmux" while it demonstrably is, or talking to a terminal it is not sitting in
# (TERM inside a pane must name what tmux emulates, not the outer terminal). The
# pane command therefore reads all three from the pane and hands them back (see
# pane_argv below). They are also stripped from FORWARD_ENV: when the launcher
# itself runs inside tmux it carries the OUTER session's copies, and a forwarded
# copy arrives after the handed-back one and wins (`env` is last-wins), which
# names the wrong session — or nothing at all, when the caller's TMUX is empty.
declare -a FORWARD_ENV=()
while IFS='=' read -r name value; do
  case "$name" in
    AIRPROMPT_DEBUG|AIRPROMPT_PID_FILE|AIRPROMPT_TMUX_SESSION|AIRPROMPT_CAPTURE) ;;  # strip internal-only vars
    TMUX|TMUX_PANE|TERM) ;;  # the pane's own — pane_argv re-adds them; a caller's copy would override that set
    AIRPROMPT_*) FORWARD_ENV+=("$name=$value") ;;  # forward config vars for deactivate hooks
    BASH_FUNC_* | BASH_ALIASES | BASH_ARGV | BASH_SOURCE | BASH_LINENO | _) ;;  # skip shell internals
    *) FORWARD_ENV+=("$name=$value") ;;
  esac
done < <(env)

# ── Per-session marker — writes name + tmux only.
# Does NOT write `url`, `active`, or `session` — those are set by
# the SessionStart hook (airprompt-activate.js) after daemon registration.
# The daemon owns session IDs; this script does not invent them.
save_session_marker() {
  local tmux_name="$1"
  local session_name="${2:-}"
  # Sanitize: use same charset as statusline/activate/on.sh — tr -cd 'a-zA-Z0-9_.-'
  local safe_name
  safe_name=$(printf '%s' "$tmux_name" | tr -cd 'a-zA-Z0-9_.-')
  [ -z "$safe_name" ] && safe_name="$(echo "$tmux_name" | tr -cd 'a-zA-Z0-9')"  # fallback: strip dots/dashes too
  [ -z "$safe_name" ] && safe_name="airprompt-unknown"
  local my_dir="${SESSIONS_DIR}/${PROVIDER_ID}-${safe_name}"
  mkdir -p "$my_dir" 2>/dev/null || true
  [ -n "$session_name" ] && printf '%s\n' "$session_name" > "${my_dir}/name"
  printf '%s\n' "$tmux_name" > "${my_dir}/tmux"
  printf '%s\n' "$PROVIDER_ID" > "${my_dir}/provider"
}

# ── Parse args ────────────────────────────────────────────────────────
RESUME_SESSION=""
RESUME_IDE_ID=""   # set when <id> is an IDE session ID, not tmux
SESSION_NAME=""       # human-readable name for the session
# Every expansion of `args` is written ${args[@]+"${args[@]}"} on purpose: bash
# 3.2 (macOS /bin/bash) reports an empty array as unbound under `set -u`, and
# `args` is empty whenever the IDE is given no arguments of its own.
args=()
while [ $# -gt 0 ]; do
  case "$1" in
    --resume)
      # Two bad values, one guard. Empty falls through to a silent fresh launch
      # — no resume, no complaint, a session nobody asked for; and a following
      # flag (`--resume --name x`) would be swallowed as the session name,
      # destroying the flag the user did type.
      case "${2:-}" in
        "" | -*)
          echo "Error: --resume requires a session name or ID" >&2
          echo "Usage: airprompt-launch --resume <session_id>" >&2
          exit 1
          ;;
      esac
      RESUME_SESSION="$2"
      shift 2
      ;;
    --continue)
      # With a session name or id this is AirPrompt's resume path, like `--resume`.
      # Bare, it is the IDE's own flag ("continue the most recent conversation"),
      # which the user typed and therefore reaches the IDE as typed — AirPrompt
      # does not decide for the CLI what it supports.
      case "${2:-}" in
        -*)
          args+=("--continue")
          shift
          ;;
        "")
          # A bare `--continue`, or one whose value came out empty
          # (`--continue "$ID"` with `$ID` unset). The empty value has to be
          # consumed too: left in place it re-enters the loop and reaches the
          # IDE as an argument, which for a CLI is a prompt, not nothing.
          args+=("--continue")
          shift
          if [ $# -gt 0 ]; then shift; fi
          ;;
        *)
          RESUME_SESSION="$2"
          shift 2
          ;;
      esac
      ;;
    --name)
      # Same two values as --resume: an empty one would name nothing while
      # looking like it did, and a flag would be taken as the name.
      case "${2:-}" in
        "" | -*)
          echo "Error: --name requires a name" >&2
          exit 1
          ;;
      esac
      SESSION_NAME="$2"
      shift 2
      ;;
    *)
      # `--` included, on purpose: it is forwarded so the IDE still sees its own
      # terminator, which is why the name pair above goes in front of the user's
      # args rather than behind them. It does not stop THIS loop — a flag of
      # AirPrompt's written after a `--` is still consumed here.
      args+=("$1")
      shift
      ;;
  esac
done

# ── Forward the session name to the IDE (when it has a name flag) ───────
# Put in front of the user's own args: a `--` terminator among them ends the
# IDE's option parsing, and the pair appended behind one would be read as
# positional text instead of a flag. Everything else still reaches the IDE
# exactly as typed. An IDE that declares no name flag is left alone — a flag it
# does not know would abort its start.
if [ -n "$SESSION_NAME" ]; then
  IDE_NAME_FLAG="$(_ide_name_flag)"
  if [ -n "$IDE_NAME_FLAG" ]; then
    args=("$IDE_NAME_FLAG" "$SESSION_NAME" ${args[@]+"${args[@]}"})
  elif [ "${AIRPROMPT_DEBUG:-}" = "1" ]; then
    echo "airprompt-launch: no session-name flag resolved for provider '$PROVIDER_ID'" >&2
    echo "  (it declares none, or the lookup failed); the AirPrompt marker — and," >&2
    echo "  on a fresh launch, the tmux session — carry the name '$SESSION_NAME'." >&2
  fi
fi

# ── Helper: the argv tmux is handed for a pane ──────────────────────
# Sets PANE_ARGV = the pane's command shell, then `env -i` with its NAME=VALUE
# list, then the wrapper that runs the IDE and captures the pane on exit.
# Shared by both paths that start a process (new-session and respawn-pane) so
# the environment rule cannot drift between them.
#
# The command shell exists only to move the values tmux owns for a pane — TMUX,
# TMUX_PANE and TERM — across `env -i`. tmux injects them into the pane's
# process; clear the environment without handing them back and the IDE sees
# `$TMUX` empty and calls itself "not inside tmux" while sitting in a pane. They
# are stripped from FORWARD_ENV so that this set is the only source — everything
# else after `-i` is the caller's environment and nothing more, which is the
# point of `-i`.
pane_argv() { # pane_argv <capture_file> [ide-args...]
  local capture_file="$1"
  shift
  # The command shell's $0 is not `_`: that name marks the IDE's own argv for
  # `bash -c … _ "$@"` below, and this shell sits in front of it.
  PANE_ARGV=(
    bash -c 'exec env -i "TMUX=$TMUX" "TMUX_PANE=$TMUX_PANE" "TERM=$TERM" "$@"' airprompt-pane
    AIRPROMPT_CAPTURE="$capture_file"
  )
  # Guarded like every other array here: bash 3.2 (macOS /bin/bash) reports an
  # empty array as unbound under `set -u`. FORWARD_ENV is never empty in
  # practice — it is `env` minus a few names — so this is parity, not a live bug.
  local var
  for var in ${FORWARD_ENV[@]+"${FORWARD_ENV[@]}"}; do
    PANE_ARGV+=("$var")
  done
  PANE_ARGV+=(
    bash -c '"$@" || true; tmux capture-pane -p -J -S -100 > "$AIRPROMPT_CAPTURE"; exit 0' _
    "$@"
  )
}

# ── Helper: run IDE inside tmux with pane-capture on exit ──────────
# Usage: launch_tmux_capture <tmux_session> <capture_file> [ide-args...]
# The wrapper bash script owns the capture file — it writes the last 100
# lines of pane output when IDE exits. The caller reads + cleans up.
launch_tmux_capture() {
  local session="$1"
  local capture_file="$2"
  shift 2
  # Args reach the IDE as argv, one element per argument (`bash -c … _ "$@"`),
  # so spaces, quotes and metachars survive untouched and no shell re-parses
  # them — no injection, no escaping needed. The exception is a forwarded env
  # VALUE containing a newline: the collector above reads `env` line by line, so
  # such a value is truncated at its first line and its tail becomes a stray
  # variable named by its own text. Every element the collector emits contains
  # an `=`, and the `env -i` operand list below always opens with the three
  # handed-back assignments — so `env` has stopped parsing its own options
  # before any collected element is read.
  pane_argv "$capture_file" "$@"
  tmux new-session -d -s "$session" "${PANE_ARGV[@]}"
  tmux set-option -t "$session" focus-events on
}

# ── Helper: attach to session, print captured output when it ends ─────
# When outside tmux: blocks until session exits, then prints capture if
# the session is really dead (not a Ctrl-B d detach).
# When inside tmux: execs switch-client — can't block, so no capture print.
attach_and_capture() {
  local session="$1"
  local capture_file="$2"

  if [ -n "${TMUX:-}" ]; then
    # Nested tmux: switch client immediately. We cannot block or print
    # captured output here — switch-client returns instantly. The user
    # will see IDE's final output inside the inner tmux pane.
    rm -f "$capture_file"
    exec tmux switch-client -t "$session"
  fi

  # Outside tmux: attach and block until session exits.
  tmux attach-session -t "$session" || true

  # Only print if session actually ended (not a detach via Ctrl-B d).
  if ! tmux has-session -t "$session" 2>/dev/null; then
    echo
    echo "Session ended."
    [ -s "$capture_file" ] && cat "$capture_file"
    rm -f "$capture_file"
  fi
  # Session still alive = user detached. Capture file stays — wrapper
  # will overwrite it when IDE eventually exits. Orphaned in /tmp
  # until reboot; acceptable for a LAN PoC. Silent exit is correct.
}

# ── Resume path ──────────────────────────────────────────────────────
if [ -n "$RESUME_SESSION" ]; then
  if tmux has-session -t "$RESUME_SESSION" 2>/dev/null; then
    # ── Known tmux session — reuse it ────────────────────────────────
    # Only a real tmux session gets a marker here. `--resume` also accepts an
    # IDE session id, and a marker keyed on one records a `tmux` name that can
    # never exist — the junk dir the sweep then has to reap. The id-resume
    # branch below writes its own marker for the session it actually creates.
    save_session_marker "$RESUME_SESSION" "$SESSION_NAME"
    # Kill zombie pane (dead from previous /exit) silently, respawn fresh.
    # Resolve the DEAD pane's id: `-t <session>` targets the session's ACTIVE
    # pane, so on a session holding a dead pane and a live one a bare session
    # target would replace the live pane — killing the very process the user is
    # returning to. Single-pane sessions (all AirPrompt makes) resolve the same.
    DEAD_PANE=""
    while read -r pane dead; do
      if [ "$dead" = "1" ]; then
        DEAD_PANE="$pane"
        break
      fi
    done < <(tmux list-panes -t "$RESUME_SESSION" -F '#{pane_id} #{pane_dead}' 2>/dev/null || true)
    if [ -n "$DEAD_PANE" ]; then
      AIRPROMPT_CAPTURE=$(mktemp)
      pane_argv "$AIRPROMPT_CAPTURE" "$REAL_BINARY" ${args[@]+"${args[@]}"}
      tmux respawn-pane -k -t "$DEAD_PANE" "${PANE_ARGV[@]}" 2>/dev/null || {
        # respawn failed — kill zombie session and create new one
        tmux kill-session -t "$RESUME_SESSION" 2>/dev/null || true
        RESUME_IDE_ID=""
        RESUME_SESSION="airprompt-$$-$(date +%s)"
        save_session_marker "$RESUME_SESSION" "$SESSION_NAME"
        launch_tmux_capture "$RESUME_SESSION" "$AIRPROMPT_CAPTURE" "$REAL_BINARY" ${args[@]+"${args[@]}"}
      }
      attach_and_capture "$RESUME_SESSION" "$AIRPROMPT_CAPTURE"
      exit 0
    fi
    # pane alive — just attach to running session, no capture needed
    if [ -n "${TMUX:-}" ]; then
      exec tmux switch-client -t "$RESUME_SESSION"
    else
      exec tmux attach-session -t "$RESUME_SESSION"
    fi
  else
    # ── Not a tmux session — treat as IDE session ID ──────────────
    RESUME_IDE_ID="$RESUME_SESSION"
    TMUX_SESSION="airprompt-$$-$(date +%s)"
    save_session_marker "$TMUX_SESSION" "$SESSION_NAME"
    AIRPROMPT_CAPTURE=$(mktemp)
    launch_tmux_capture "$TMUX_SESSION" "$AIRPROMPT_CAPTURE" "$REAL_BINARY" --resume "$RESUME_IDE_ID" ${args[@]+"${args[@]}"}
    attach_and_capture "$TMUX_SESSION" "$AIRPROMPT_CAPTURE"
    exit 0
  fi
fi

# ── Already inside tmux — just run real IDE, save session name ────
if [ -n "${TMUX:-}" ]; then
  # A set TMUX is not proof the session is reachable: a launcher that inherits
  # one whose server is gone still lands here, and `display-message` then fails.
  # Marking on that empty result would key the dir on save_session_marker's
  # `airprompt-unknown` fallback — a marker naming no tmux session, the same
  # junk the resume path no longer writes.
  SESSION_NAME_TMUX=$(tmux display-message -p '#S' 2>/dev/null || true)
  # A web-proxy pane is named `airprompt-web-…`; the session it drives is the
  # group it belongs to. Every other call site maps it back before using it as a
  # key (off.sh, name.sh, statusline.sh, activate.js, deactivate.js) — without
  # the same step here, a launch from a phone pane files its marker under the
  # proxy, and `airprompt off`/`name` on the real session cannot find it.
  if echo "$SESSION_NAME_TMUX" | grep -q '^airprompt-web-'; then
    PROXY_GROUP=$(tmux display-message -p '#{session_group}' 2>/dev/null || true)
    # Only a session that really belongs to a group is a proxy. An ungrouped
    # session can still be *named* `airprompt-web-…` — `--name web-x` produces
    # exactly that — and mapping it to an empty group would drop the marker
    # altogether, where activate.js and deactivate.js keep the name instead.
    if [ -n "$PROXY_GROUP" ]; then
      SESSION_NAME_TMUX="$PROXY_GROUP"
    fi
  fi
  if [ -n "$SESSION_NAME_TMUX" ]; then
    save_session_marker "$SESSION_NAME_TMUX" "$SESSION_NAME"
  fi
  exec "$REAL_BINARY" ${args[@]+"${args[@]}"}
fi

# ── Not in tmux — create a tmux session and run IDE inside ────────
if [ -n "$SESSION_NAME" ]; then
  SANITIZED=$(echo "$SESSION_NAME" | tr -cd 'a-zA-Z0-9_.-')
  TMUX_SESSION="airprompt-${SANITIZED}"
else
  TMUX_SESSION="airprompt-$$-$(date +%s)"
fi
save_session_marker "$TMUX_SESSION" "$SESSION_NAME"

AIRPROMPT_CAPTURE=$(mktemp)
launch_tmux_capture "$TMUX_SESSION" "$AIRPROMPT_CAPTURE" "$REAL_BINARY" ${args[@]+"${args[@]}"}
attach_and_capture "$TMUX_SESSION" "$AIRPROMPT_CAPTURE"

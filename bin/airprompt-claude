#!/bin/bash
# airprompt-claude — Start Claude Code inside tmux so AirPrompt can
# mirror it on your phone. Version-controlled in the AirPrompt repo.
#
# Usage:  airprompt-claude [claude-args...]
#         airprompt-claude --continue
#         airprompt-claude --continue <session_id>
#         airprompt-claude --resume <session_id>
#         airprompt-claude --name <name> [claude-args...]
#
# --resume / --continue <id> accepts both:
#   • tmux session name  (e.g. claude-149509-1785091896)
#   • Claude session ID  (e.g. 3bc8beca-35eb-44ef-a75b-d6c07564ae25)
# If <id> is not a tmux session, we create one and run claude --resume <id>.
#
# --name gives a stable, human-readable tmux session name (sanitised).

set -euo pipefail

REAL_CLAUDE="$HOME/.local/bin/claude"
CONFIG_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
SESSIONS_DIR="${CONFIG_DIR}/.airprompt/sessions"

if [ ! -x "$REAL_CLAUDE" ]; then
  echo "Error: Claude not found at $REAL_CLAUDE" >&2
  exit 1
fi

# ── Collect env vars to forward to claude inside tmux ──────────────────
# Tmux does NOT forward all env vars to new sessions by default — only the
# ones listed in update-environment (DISPLAY, SSH_*, etc.). Inline env vars
# like CLAUDE_CODE_EFFORT_LEVEL=high airprompt-claude would never reach the
# real claude process. We collect everything except AirPrompt-internal vars
# (AIRPROMPT_*) and pass them explicitly via `env` in every tmux command.
declare -a FORWARD_ENV=()
while IFS='=' read -r name value; do
  case "$name" in
    AIRPROMPT_*) ;;
    *) FORWARD_ENV+=("$name=$value") ;;
  esac
done < <(env)

# ── Per-session marker — writes name + tmux only.
# Does NOT write `url`, `active`, or `session` — those are set by
# the SessionStart hook (airprompt-activate.js) after daemon registration.
# The daemon owns session IDs; this script does not invent them.
save_session_marker() {
  local tmux_name="$1"
  local session_name="${2:-}"
  # Sanitize: use same charset as statusline/activate/on.sh — tr -cd 'a-zA-Z0-9_.-'
  local safe_name=$(printf '%s' "$tmux_name" | tr -cd 'a-zA-Z0-9_.-')
  [ -z "$safe_name" ] && safe_name="$(echo "$tmux_name" | tr -cd 'a-zA-Z0-9')"  # fallback: strip dots/dashes too
  [ -z "$safe_name" ] && safe_name="airprompt-unknown"
  local my_dir="${SESSIONS_DIR}/${safe_name}"
  mkdir -p "$my_dir" 2>/dev/null || true
  [ -n "$session_name" ] && printf '%s\n' "$session_name" > "${my_dir}/name"
  printf '%s\n' "$tmux_name" > "${my_dir}/tmux"
}

# ── Parse args ────────────────────────────────────────────────────────
RESUME_SESSION=""
RESUME_CLAUDE_ID=""   # set when <id> is a Claude session UUID, not tmux
SESSION_NAME=""       # human-readable name for the session
args=()
while [ $# -gt 0 ]; do
  case "$1" in
    --resume)
      if [ $# -lt 2 ]; then
        echo "Error: --resume requires a session name or ID" >&2
        echo "Usage: airprompt-claude --resume <session_id>" >&2
        exit 1
      fi
      RESUME_SESSION="$2"
      shift 2
      ;;
    --continue)
      if [ $# -ge 2 ] && echo "$2" | grep -qv '^-'; then
        RESUME_SESSION="$2"
        shift 2
      else
        shift
      fi
      ;;
    --name)
      if [ $# -lt 2 ]; then
        echo "Error: --name requires a name" >&2
        exit 1
      fi
      SESSION_NAME="$2"
      shift 2
      ;;
    *)
      args+=("$1")
      shift
      ;;
  esac
done

# ── Resume path ──────────────────────────────────────────────────────
if [ -n "$RESUME_SESSION" ]; then
  save_session_marker "$RESUME_SESSION" "$SESSION_NAME"

  if tmux has-session -t "$RESUME_SESSION" 2>/dev/null; then
    # ── Known tmux session — reuse it ────────────────────────────────
    # Kill zombie pane (dead from previous /exit) silently, respawn fresh.
    dead=$(tmux list-panes -t "$RESUME_SESSION" -F '#{pane_dead}' 2>/dev/null || true)
    if echo "$dead" | tr -d '[:space:]' | grep -q '1'; then
      tmux respawn-pane -k -t "$RESUME_SESSION" bash -c '"$@" || true; echo; echo "Session ended. Closing..."; sleep 3; exit 0' _ env "${FORWARD_ENV[@]}" "$REAL_CLAUDE" "${args[@]}" 2>/dev/null || {
        # respawn failed — kill zombie session and create new one
        tmux kill-session -t "$RESUME_SESSION" 2>/dev/null || true
        RESUME_CLAUDE_ID=""
        RESUME_SESSION="claude-$$-$(date +%s)"
        save_session_marker "$RESUME_SESSION" "$SESSION_NAME"
        tmux new-session -d -s "$RESUME_SESSION" bash -c '"$@" || true; echo; echo "Session ended. Closing..."; sleep 3; exit 0' _ env "${FORWARD_ENV[@]}" "$REAL_CLAUDE" "${args[@]}"
        tmux set-option -t "$RESUME_SESSION" focus-events on
      }
    fi
    # Attach
    if [ -n "${TMUX:-}" ]; then
      exec tmux switch-client -t "$RESUME_SESSION"
    else
      exec tmux attach-session -t "$RESUME_SESSION"
    fi
  else
    # ── Not a tmux session — treat as Claude session ID ──────────────
    RESUME_CLAUDE_ID="$RESUME_SESSION"
    TMUX_SESSION="claude-$$-$(date +%s)"
    save_session_marker "$TMUX_SESSION" "$SESSION_NAME"
    tmux new-session -d -s "$TMUX_SESSION" bash -c '"$@" || true; echo; echo "Session ended. Closing..."; sleep 3; exit 0' _ env "${FORWARD_ENV[@]}" "$REAL_CLAUDE" --resume "$RESUME_CLAUDE_ID"
    tmux set-option -t "$TMUX_SESSION" focus-events on
    if [ -n "${TMUX:-}" ]; then
      exec tmux switch-client -t "$TMUX_SESSION"
    else
      exec tmux attach-session -t "$TMUX_SESSION"
    fi
  fi
fi

# ── Already inside tmux — just run real Claude, save session name ────
if [ -n "${TMUX:-}" ]; then
  SESSION_NAME_TMUX=$(tmux display-message -p '#S' 2>/dev/null)
  save_session_marker "$SESSION_NAME_TMUX" "$SESSION_NAME"
  exec "$REAL_CLAUDE" "${args[@]}"
fi

# ── Not in tmux — create a tmux session and run Claude inside ────────
if [ -n "$SESSION_NAME" ]; then
  SANITIZED=$(echo "$SESSION_NAME" | tr -cd 'a-zA-Z0-9_-')
  TMUX_SESSION="claude-${SANITIZED}"
else
  TMUX_SESSION="claude-$$-$(date +%s)"
fi
save_session_marker "$TMUX_SESSION" "$SESSION_NAME"

# Bash wrapper runs Claude via "$@". When Claude exits (regardless of
# exit code), prints the resume message that Claude outputs then waits
# for Enter.
tmux new-session -d -s "$TMUX_SESSION" bash -c '"$@" || true; echo; echo "Session ended. Closing..."; sleep 3; exit 0' _ env "${FORWARD_ENV[@]}" "$REAL_CLAUDE" "${args[@]}"
tmux set-option -t "$TMUX_SESSION" focus-events on
exec tmux attach-session -t "$TMUX_SESSION"
